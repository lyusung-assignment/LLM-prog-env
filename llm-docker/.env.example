# Copy this file to .env and fill in the values. .env is never committed.
#   Windows PowerShell:  Copy-Item .env.example .env

# JupyterLab access token (entered at http://localhost:8888)
JUPYTER_TOKEN=llm

# HuggingFace token - only needed to pull gated models (Llama, etc.)
HF_TOKEN=

# Only needed when calling the OpenAI API from LangChain
OPENAI_API_KEY=
